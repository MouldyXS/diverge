# Line endings: text files are stored with LF in the repository and checked out with LF on every platform,
# whatever core.autocrlf says on the machine (Windows included). Binary detection stays automatic.
* text=auto eol=lf

# Formats used by the project, explicit so the intent does not depend on content sniffing.
*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.csv  text eol=lf
*.txt  text eol=lf
*.ini  text eol=lf

# Lockfile: generated by npm (LF), kept byte-stable.
package-lock.json text eol=lf
